# Copy to .env and fill in real values. .env is git-ignored.
# Every setting below is optional; the values shown are the defaults.

# Models (only "ollama" is supported so far)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Minutes Ollama keeps a model loaded after a call (-1 = until Ollama stops). Ollama's own default
# is 5, and reloading the chat model adds 15-30 s to the next answer on a laptop CPU.
OLLAMA_KEEP_ALIVE_MINUTES=30

# Chunking (characters). Changing either re-processes every file on the next ingest run.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval: of the k passages for a question, keep up to PREFERRED_DOC_TYPE_SLOTS for this document type
# (the doc_type folder), when such passages are at most PREFERRED_DOC_TYPE_MAX_GAP (cosine distance) further
# from the question than the closest passage. Stops a few large guides crowding out the release notes.
# Leave PREFERRED_DOC_TYPE empty (or set the slots to 0) to always return the plain k closest passages.
PREFERRED_DOC_TYPE=release-notes
PREFERRED_DOC_TYPE_SLOTS=2
PREFERRED_DOC_TYPE_MAX_GAP=0.15

# Hybrid retrieval: besides the vector search, search the chunks by keyword (PostgreSQL full-text search, finds
# exact terms such as issue IDs and facts stated in one sentence of a chunk about something else), then merge the
# two rankings: each passage scores 1 / (HYBRID_RRF_K + its rank) in each list it is in (Reciprocal Rank Fusion).
# A smaller HYBRID_RRF_K favours the top of each list over passages both searches found lower down.
# The first start with it on adds a generated column and index to the chunks table (no re-ingest needed).
HYBRID_SEARCH=true
HYBRID_RRF_K=10

DOCUMENTS_DIR=documents
# Largest file (in MB) the document library accepts for upload
MAX_UPLOAD_MB=50

# Vector store (only "pgvector" is supported so far)
VECTOR_STORE=pgvector
VECTOR_TABLE=chunks

# Local Docker database (docker compose up -d); local-only development password.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and stalls.
DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5433/rag
# A remote PostgreSQL instead, via an SSH tunnel (ssh -N -L 5432:localhost:5432 <hosting-server>):
# DATABASE_URL=postgresql://rag_app:<password>@127.0.0.1:5432/rag

# HTTP API: browser origins (e.g. the React dev server) allowed to call it, comma-separated.
# This is the address the browser shows, so localhost is fine here.
API_CORS_ORIGINS=http://localhost:5173

# Serve the built web app at / from the API itself (on a server, so it needs no Node.js): build it with
# `cd frontend && npm run build`, then set this to frontend/dist (relative to where the API is started)
# or an absolute path. The API then refuses to start if the folder has no index.html.
# Leave empty in development: run the web app with `npm run dev` (Vite) as usual.
FRONTEND_DIST=

# Question log: the API appends one JSON line per /chat question to this file (question, filters, outcome,
# time taken, the answer, and every passage the model was given, with which search found it and whether it
# was cited). Plain text, as confidential as the documents; it only grows. Leave empty to turn it off.
QUESTION_LOG=
