# Copy to .env and fill in real values. .env is git-ignored.
# Every setting below is optional; the values shown are the defaults.

# Models (only "ollama" is supported so far)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Minutes Ollama keeps a model loaded after a call (-1 = until Ollama stops). Ollama's own default
# is 5, and reloading the chat model adds 15-30 s to the next answer on a laptop CPU.
OLLAMA_KEEP_ALIVE_MINUTES=30

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

DOCUMENTS_DIR=documents
# Largest file (in MB) the document library accepts for upload
MAX_UPLOAD_MB=50

# Vector store (only "pgvector" is supported so far)
VECTOR_STORE=pgvector
VECTOR_TABLE=chunks

# Local Docker database (docker compose up -d); local-only development password.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and stalls.
DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5433/rag
# A remote PostgreSQL instead, via an SSH tunnel (ssh -N -L 5432:localhost:5432 <hosting-server>):
# DATABASE_URL=postgresql://rag_app:<password>@127.0.0.1:5432/rag

# HTTP API: browser origins (e.g. the React dev server) allowed to call it, comma-separated.
# This is the address the browser shows, so localhost is fine here.
API_CORS_ORIGINS=http://localhost:5173

# Serve the built web app at / from the API itself (on a server, so it needs no Node.js): build it with
# `cd frontend && npm run build`, then set this to frontend/dist (relative to where the API is started)
# or an absolute path. The API then refuses to start if the folder has no index.html.
# Leave empty in development: run the web app with `npm run dev` (Vite) as usual.
FRONTEND_DIST=
