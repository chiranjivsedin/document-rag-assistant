# Copy to .env and fill in real values. .env is git-ignored.
# Every setting below is optional; the values shown are the defaults.

# Models (only "ollama" is supported so far)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

DOCUMENTS_DIR=documents

# Database (not needed yet). A remote PostgreSQL reached through an SSH tunnel:
#   ssh -N -L 5432:localhost:5432 <hosting-server>
# DATABASE_URL=postgresql://rag_app:<password>@localhost:5432/rag
